<?xml version="1.0" encoding="utf-8"?>
<!-- Sondarr.Auth.Shared lives on GitHub Packages. No credentials here: see the
     vault note 05-Auth/auth-nuget-integration.md for local PAT and CI setup. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/Xerant/index.json" />
  </packageSources>
</configuration>
