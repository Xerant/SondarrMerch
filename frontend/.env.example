# Sondarr Merch — copy to .env.local for local development.

# Merch API (SondarrMerch/backend), including /api
VITE_MERCH_API_URL=http://localhost:5010/api

# Same Supabase project as every other Sondarr site. Anon key only —
# the service_role key never belongs in a frontend.
VITE_SUPABASE_URL=https://xgztnswiiisfmblgrezi.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Main music site, for "Back to Sondarr" and "Create your account" links.
VITE_SONDARR_APP_URL=http://localhost:5173
